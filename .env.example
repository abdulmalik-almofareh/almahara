# انسخ هذا الملف باسم .env.local عند التشغيل على جهازك، وضع نفس القيم في Vercel → Settings → Environment Variables

# من Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# رابط موقعك النهائي (بدون / في النهاية)
NEXT_PUBLIC_SITE_URL=https://almahara.com

# من Resend: API Keys (لإرسال رسائل الدعوات)
RESEND_API_KEY=re_xxxxxxxx
# المرسل: يجب أن يكون من دومين موثّق في Resend
EMAIL_FROM=المهرة <noreply@almahara.com>
